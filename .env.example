# Server-side Supabase project URL used by the Apple Health ingestion API/function.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only credentials. Never expose these in frontend code or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APPLE_HEALTH_SYNC_TOKEN=replace-with-a-long-random-token

# Optional GitHub archive target for server-side health integrations.
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-private-repo
GITHUB_BRANCH=main
GITHUB_PAT=your-github-pat
