# Supabase project credentials.
# Copy this file to .env and fill in real values. .env is gitignored.
#
# Find these in your Supabase dashboard:
#   - Project URL:  Settings -> API -> Project URL
#   - anon key:     Settings -> API -> Project API keys -> "anon" / "public"
#
# Both credentials drive BOTH cloud sync (src/scripts/sync.js) and Auth
# (login.html + src/scripts/auth.js). Without them, /login.html will show
# "Supabase Auth is not configured in this build" and other pages will
# redirect to it.
#
# After editing this file you MUST run `npm run build` so scripts/build.js
# can substitute these values into dist/scripts/supabase-client.js. The
# deployed bundle is dist/, NOT src/ — opening src/pages/login.html in a
# browser directly will never work because the placeholder tokens are
# still in place.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

# Server-only Apple Health Shortcut endpoint credentials.
# Never expose these in frontend code or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APPLE_HEALTH_SYNC_TOKEN=replace-with-a-long-random-token

# Optional Edge Function archive target. These are server-only Supabase secrets.
# GITHUB_PAT needs repository Contents: write access to the private repository.
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-private-repo
GITHUB_BRANCH=main
GITHUB_PAT=your-github-fine-grained-token
