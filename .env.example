# Supabase project credentials.
# Copy this file to .env and fill in real values. .env is gitignored.
#
# Find these in your Supabase dashboard:
#   - Project URL:  Settings -> API -> Project URL
#   - anon key:     Settings -> API -> Project API keys -> "anon" / "public"
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

# Server-only Apple Health Shortcut endpoint credentials.
# Never expose these in frontend code or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APPLE_HEALTH_SYNC_TOKEN=replace-with-a-long-random-token
