{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/health", "destination": "/health.html" },
    { "source": "/health.html", "destination": "/health.html" },
    { "source": "/gym", "destination": "/gym.html" },
    { "source": "/gym.html", "destination": "/gym.html" },
    { "source": "/grind-log", "destination": "/grind-log.html" },
    { "source": "/grind-log.html", "destination": "/grind-log.html" },
    { "source": "/progression-tab", "destination": "/progression-tab.html" },
    { "source": "/progression-tab.html", "destination": "/progression-tab.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/login.html", "destination": "/login.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
